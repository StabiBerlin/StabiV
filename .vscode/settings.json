{
  "editor.rulers": [140],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[java]": {
    "editor.defaultFormatter": "RudraPatel.prettier-plugin-java-vscode"
  },
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.configuration.maven.notCoveredPluginExecutionSeverity": "ignore",
  "java.checkstyle.configuration": "${workspaceFolder}/code/parent/src/main/resources/checkstyle.xml",
  "languageToolLinter.languageTool.ignoredWordsInWorkspace": [
    "exiftool",
    "i-th",
    "ifds",
    "jhove",
    "jsonpath",
    "jsonpaths",
    "redhat",
    "spk-berlin"
  ]
}
