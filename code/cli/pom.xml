<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.spkberlin.imagevalidation</groupId>
    <artifactId>imagevalidation-parent-pom</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <relativePath>../parent/pom.xml</relativePath>
  </parent>
  <artifactId>imagevalidation-cli</artifactId>
  <packaging>jar</packaging>

  <name>Image Validation CLI</name>

  <properties>
    <main.class>de.spkberlin.imagevalidation.cli.entrypoint.Main</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-layout-template-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>de.spkberlin.imagevalidation</groupId>
      <artifactId>imagevalidation-extractor-exiftool</artifactId>
    </dependency>
    <dependency>
      <groupId>de.spkberlin.imagevalidation</groupId>
      <artifactId>imagevalidation-extractor-jhove</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <skip>false</skip>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>${picocli.version}</version>
            <type>jar</type>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>generateManPages</id>
            <goals>
              <goal>java</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <includeProjectDependencies>true</includeProjectDependencies>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>picocli.codegen.docgen.manpage.ManPageGenerator</mainClass>
              <arguments>
                <argument>--outdir=${project.build.directory}/generated-picocli-docs</argument>
                <argument>de.spkberlin.imagevalidation.cli.commands.MainCommand</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.asciidoctor</groupId>
        <artifactId>asciidoctor-maven-plugin</artifactId>
        <configuration>
          <sourceDirectory>${project.build.directory}/generated-picocli-docs</sourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>output-html</id>
            <goals>
              <goal>process-asciidoc</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <sourceHighlighter>coderay</sourceHighlighter>
              <backend>html5</backend>
              <attributes>
                <linkcss>false</linkcss>
                <source-highlighter>coderay</source-highlighter>
              </attributes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Linux tar -->
    <profile>
      <id>assembly-linux</id>
      <activation>
        <os>
          <name>Linux</name>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <configuration>
              <inlineDescriptors>
                <inlineDescriptor>
                  <id>linux-x64</id>
                  <includeBaseDirectory>false</includeBaseDirectory>
                  <formats>
                    <format>dir</format>
                    <format>tar.gz</format>
                  </formats>
                  <fileSets>
                    <fileSet>
                      <directory>src/main/assembly/linux</directory>
                      <outputDirectory>.</outputDirectory>
                      <includes>
                        <include>*</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.basedir}/../common/src/test/resources/examples</directory>
                      <outputDirectory>examples</outputDirectory>
                      <includes>
                        <include>**</include>
                      </includes>
                      <excludes>
                        <exclude>**/output.csv</exclude>
                      </excludes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.build.directory}/generated-docs</directory>
                      <outputDirectory>documentation/cli</outputDirectory>
                      <includes>
                        <include>*.html</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.basedir/../../documentation/userguide}</directory>
                      <outputDirectory>documentation/userguide</outputDirectory>
                      <includes>
                        <include>*.md</include>
                        <include>*.pdf</include>
                      </includes>
                    </fileSet>
                  </fileSets>
                  <files>
                    <file>
                      <source>${project.build.directory}/${project.build.finalName}.jar</source>
                      <outputDirectory>tools/spk-iv-cli</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../CHANGELOG.md}</source>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../CHANGELOG.pdf}</source>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../documentation/getting-started/Linux.md}</source>
                      <destName>README.md</destName>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../documentation/getting-started/Linux.pdf}</source>
                      <destName>README.pdf</destName>
                      <outputDirectory>.</outputDirectory>
                    </file>
                  </files>
                </inlineDescriptor>
              </inlineDescriptors>
            </configuration>
            <executions>
              <execution>
                <id>make-assembly</id>
                <goals>
                  <goal>single</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Windows zip -->
    <profile>
      <id>assembly-windows</id>
      <activation>
        <os>
          <family>Windows</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <configuration>
              <inlineDescriptors>
                <inlineDescriptor>
                  <id>windows-x64</id>
                  <includeBaseDirectory>false</includeBaseDirectory>
                  <formats>
                    <format>dir</format>
                    <format>zip</format>
                  </formats>
                  <fileSets>
                    <fileSet>
                      <directory>src/main/assembly/windows</directory>
                      <outputDirectory>.</outputDirectory>
                      <includes>
                        <include>*</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.basedir}/../common/src/test/resources/examples</directory>
                      <outputDirectory>examples</outputDirectory>
                      <includes>
                        <include>**</include>
                      </includes>
                      <excludes>
                        <exclude>**/output.csv</exclude>
                      </excludes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.build.directory}/generated-docs</directory>
                      <outputDirectory>documentation/cli</outputDirectory>
                      <includes>
                        <include>*.html</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${project.basedir/../../documentation/userguide}</directory>
                      <outputDirectory>documentation/userguide</outputDirectory>
                      <includes>
                        <include>*.md</include>
                        <include>*.pdf</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${env.JAVA_HOME}</directory>
                      <outputDirectory>tools/java</outputDirectory>
                      <includes>
                        <include>**</include>
                      </includes>
                    </fileSet>
                    <fileSet>
                      <directory>${env.EXIFTOOL_HOME}</directory>
                      <outputDirectory>tools/exiftool</outputDirectory>
                      <includes>
                        <include>**</include>
                      </includes>
                    </fileSet>
                  </fileSets>
                  <files>
                    <file>
                      <source>${project.build.directory}/${project.build.finalName}.jar</source>
                      <outputDirectory>tools/spk-iv-cli</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../CHANGELOG.md}</source>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../CHANGELOG.pdf}</source>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../documentation/getting-started/Windows.md}</source>
                      <destName>README.md</destName>
                      <outputDirectory>.</outputDirectory>
                    </file>
                    <file>
                      <source>${project.basedir/../../documentation/getting-started/Windows.pdf}</source>
                      <destName>README.pdf</destName>
                      <outputDirectory>.</outputDirectory>
                    </file>
                  </files>
                </inlineDescriptor>
              </inlineDescriptors>
            </configuration>
            <executions>
              <execution>
                <id>make-assembly</id>
                <goals>
                  <goal>single</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
