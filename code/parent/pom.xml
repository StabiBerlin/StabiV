<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.spkberlin.imagevalidation</groupId>
  <artifactId>imagevalidation-parent-pom</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Image Validation Parent Pom</name>
  <url>http://github.com/TODO</url>

  <modules>
    <module>../cli</module>
    <module>../common</module>
    <module>../extractor-exiftool</module>
    <module>../extractor-jhove</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>

    <!--dependency versions -->
    <commons-csv.version>1.14.1</commons-csv.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <jackson-databind.version>3.1.0</jackson-databind.version>
    <jhove.version>1.32.1</jhove.version>
    <jhove.modules.gif.hul.version>1.4.3</jhove.modules.gif.hul.version>
    <jhove.modules.jpeg2000.hul.version>1.4.4</jhove.modules.jpeg2000.hul.version>
    <jhove.modules.jpeg.hul.version>1.5.4</jhove.modules.jpeg.hul.version>
    <jhove.modules.pdf.hul.version>1.12.7</jhove.modules.pdf.hul.version>
    <jhove.modules.tiff.hul.version>1.9.5</jhove.modules.tiff.hul.version>
    <jpackage-maven-plugin.version>1.7.4</jpackage-maven-plugin.version>
    <json.version>20251224</json.version>
    <junit-bom.version>6.0.3</junit-bom.version>
    <log4j.version>2.25.3</log4j.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
    <picocli.version>4.7.7</picocli.version>
    <slf4j-api.version>2.0.17</slf4j-api.version>
    <spotless-maven-plugin.version>3.3.0</spotless-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-layout-template-json</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j-impl</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli-codegen</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson-databind.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove</groupId>
        <artifactId>jhove-core</artifactId>
        <version>${jhove.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove.modules</groupId>
        <artifactId>gif-hul</artifactId>
        <version>${jhove.modules.gif.hul.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove.modules</groupId>
        <artifactId>jpeg2000-hul</artifactId>
        <version>${jhove.modules.jpeg2000.hul.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove.modules</groupId>
        <artifactId>jpeg-hul</artifactId>
        <version>${jhove.modules.jpeg.hul.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove.modules</groupId>
        <artifactId>pdf-hul</artifactId>
        <version>${jhove.modules.pdf.hul.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openpreservation.jhove.modules</groupId>
        <artifactId>tiff-hul</artifactId>
        <version>${jhove.modules.tiff.hul.version}</version>
      </dependency>
      <dependency>
        <groupId>de.spkberlin.imagevalidation</groupId>
        <artifactId>imagevalidation-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.spkberlin.imagevalidation</groupId>
        <artifactId>imagevalidation-extractor-exiftool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.spkberlin.imagevalidation</groupId>
        <artifactId>imagevalidation-extractor-jhove</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven-shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.panteleyev</groupId>
          <artifactId>jpackage-maven-plugin</artifactId>
          <version>${jpackage-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- plugin configuration -->
    <plugins>
      <!-- checkstyle -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>src/main/resources/checkstyle.xml</configLocation>
          <encoding>UTF-8</encoding>
          <consoleOutput>true</consoleOutput>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>

      <!-- spotless -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <!-- java auto format -->
          <java>
            <includes>
              <include>src/**/*.java</include>
              <include>test/**/*.java</include>
            </includes>
            <prettier>
              <devDependencies>
                <prettier>3.8.1</prettier>
                <prettier-plugin-java>2.8.1</prettier-plugin-java>
              </devDependencies>
              <config>
                <tabWidth>4</tabWidth>
                <printWidth>140</printWidth>
                <parser>java</parser>
                <plugins>prettier-plugin-java</plugins>
              </config>
            </prettier>
          </java>
          <!-- pom auto format -->
          <pom>
            <sortPom/>
          </pom>
          <!-- yaml auto format -->
          <yaml>
            <includes>
              <include>src/**/*.yaml</include>
              <include>test/**/*.yaml</include>
            </includes>
            <jackson/>
          </yaml>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
